# All optional. Each tool switches on only when its value is set at build time (Vercel: Project Settings > Environment Variables).
SITE_URL=https://www.salmanfaris.in
PUBLIC_GA4_ID=
PUBLIC_GTM_ID=
PUBLIC_CLARITY_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_BING_VERIFICATION=
# Form service endpoint (Formspree, Web3Forms or your own). Empty means forms open the visitor's email app.
PUBLIC_FORM_ENDPOINT=

# Hosted Razorpay Payment Pages (public URLs, never secret keys).
# Course checkout appears only when its record is available and has a confirmed fee.
PUBLIC_RAZORPAY_AI_WEB_DEVELOPMENT=
PUBLIC_RAZORPAY_AI_VIBE_CODING=
PUBLIC_RAZORPAY_AI_REEL_AUTOMATION=
PUBLIC_RAZORPAY_MENTORSHIP=
