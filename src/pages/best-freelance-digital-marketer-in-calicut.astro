---
// Landing page for "best freelance digital marketer in Calicut" and "best digital marketer in Calicut".
// The honest angle: no ranking exists, so the page shows checkable proof and gives visitors 10 checks to judge anyone.
import ContactBlock from '../components/ContactBlock.astro';
import FaqList from '../components/FaqList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {
  checks, clients, compareRows, credentials, firstMonth, healthQuestions, heroFacts, localPoints, loop,
  MARKETER_PATH, MARKETER_UPDATED, marketerFaqs, marketingServices, priceModels, reviews, scoreBands,
} from '../data/marketer';
import { profile, projectById } from '../data/portfolio';
import PageShell from '../layouts/PageShell.astro';
import { absolute, breadcrumbNode, faqNode, PERSON_ID, webPageNode } from '../lib/schema';

const path = MARKETER_PATH;
const pageTitle = 'Best Freelance Digital Marketer in Calicut? See the Proof';
const pageDescription = 'Salman Faris is a freelance digital marketer in Calicut who also builds websites and edits reels: SEO, local SEO, ads and tracking, with live work you can check.';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Freelance digital marketer in Calicut', path }];
const proof = ['media-360-concept', 'reel-series', 'reelbot'].map(projectById);
const serviceId = `${absolute(path)}#service`;
const contactHref = '/contact/?service=Digital%20marketing#project';
const pad = (n: number) => String(n).padStart(2, '0');

const structuredData = [
  webPageNode(path, pageTitle, pageDescription, {
    mainEntity: { '@id': serviceId },
    breadcrumb: { '@id': `${absolute(path)}#breadcrumb` },
    primaryImageOfPage: { '@type': 'ImageObject', url: absolute('/images/portrait.webp'), width: 760, height: 950 },
    datePublished: '2026-11-15',
    dateModified: MARKETER_UPDATED,
  }),
  {
    '@type': 'Service',
    '@id': serviceId,
    name: 'Freelance digital marketing in Calicut',
    serviceType: ['Digital marketing', 'Search engine optimization', 'Local SEO', 'Social media marketing', 'Online advertising', 'Conversion tracking'],
    description: pageDescription,
    url: absolute(path),
    provider: { '@id': PERSON_ID },
    areaServed: [
      { '@type': 'City', name: 'Kozhikode', alternateName: 'Calicut' },
      { '@type': 'State', name: 'Kerala' },
      { '@type': 'Country', name: 'India' },
    ],
    availableLanguage: ['en', 'ml'],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Digital marketing services',
      itemListElement: marketingServices.map((item) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: item.title, description: item.text, url: absolute(item.href.startsWith('/contact') ? path : item.href) },
      })),
    },
  },
  breadcrumbNode(path, crumbs),
  faqNode(path, marketerFaqs),
];
---
<PageShell pageTitle={pageTitle} pageDescription={pageDescription} structuredData={structuredData} modifiedTime={MARKETER_UPDATED}>
  <span data-view-event="landing_view" data-view-label="best-freelance-digital-marketer-calicut" hidden></span>

  <section class="page-hero mk-hero" aria-labelledby="mk-title">
    <div class="wrap mk-hero-grid">
      <div class="mk-hero-main">
        <nav aria-label="Breadcrumb">
          <ol class="crumbs">
            {crumbs.map((crumb, index) => <li>{index === crumbs.length - 1 ? <span aria-current="page">{crumb.name}</span> : <a href={crumb.path}>{crumb.name}</a>}</li>)}
          </ol>
        </nav>
        <p class="section-tag">Freelance digital marketer · Calicut (Kozhikode), Kerala</p>
        <h1 class="mk-title" id="mk-title"><span>The best freelance digital marketer in Calicut</span> <em>is the one who can prove it.</em></h1>
        <p class="page-lead">I’m Salman Faris. I plan the marketing, build the website, edit the reels and set up the tracking myself, so you can see which work brings enquiries. Below is my proof, how I work, and 10 checks you can use on any marketer, including me.</p>
        <div class="page-actions">
          <a class="btn btn-red" href="#health-check" data-cta="mk_hero_check">Score your marketing in 60 s</a>
          <a class="btn btn-glass" href={contactHref} data-cta="mk_hero_project">Start a project</a>
        </div>
        <ul class="mk-facts" aria-label="Quick facts">{heroFacts.map((fact) => <li>{fact}</li>)}</ul>
        <div class="mk-answer">
          <p class="mk-answer-label">Short answer</p>
          <p>There is no official ranking, so the best freelance digital marketer in Calicut is the one whose work you can check. Salman Faris is a Kozhikode-based freelance digital marketer who also builds websites and edits video, so strategy, site, content and tracking come from one accountable person.</p>
        </div>
      </div>

      <aside class="mk-panel" aria-label="Proof at a glance">
        <div class="mk-panel-head"><span class="mk-live"><i class="pulse" aria-hidden="true"></i>Live</span><span>PROOF.LOG</span></div>
        <div class="mk-meter" data-meter>
          <span class="mk-meter-label">This page opened for you in</span>
          <strong class="mk-meter-value" data-meter-time>a moment</strong>
          <span class="mk-meter-sub"><span data-meter-weight>Plain HTML</span> · measured in your browser, not a screenshot</span>
        </div>
        <dl class="mk-stats">
          <div><dt>Jobs done in-house: strategy, web, video, tracking</dt><dd>4</dd></div>
          <div><dt>Malayalam reels made in one month</dt><dd>30</dd></div>
          <div><dt>Public GitHub repositories</dt><dd>90+</dd></div>
          <div><dt>Invented reviews on this site</dt><dd>0</dd></div>
        </dl>
        <div class="mk-person">
          <img src="/images/portrait-avatar.webp" alt="Illustrated portrait used by Salman Faris" width="112" height="112" loading="lazy" decoding="async" />
          <p><strong>Salman Faris</strong><span>Freelance digital marketer, developer and video editor · Kozhikode</span></p>
        </div>
      </aside>
    </div>
  </section>

  <section class="page-section" id="proof" aria-labelledby="proof-title">
    <div class="wrap">
      <p class="section-tag">01 · Proof</p>
      <h2 class="block-title" id="proof-title">Proof you can check in two minutes</h2>
      <p class="block-desc">Live work, measured numbers and code you can open. Concepts stay labelled as concepts, and nothing here is a stock case study.</p>
      <div class="bento-grid">
        {proof.map((project) => <ProjectCard project={project} />)}
        <article class="card mk-site-card">
          <p class="chip">This website</p>
          <h3 class="bento-title">salmanfaris.in, built for search</h3>
          <p class="bento-text">Over 70 pages with structured data on every one, and an automatic check that blocks broken links, duplicate titles, thin service pages and fake rating markup before any release.</p>
          <ul class="spec-list"><li>Static HTML, no page builder</li><li>Self-hosted fonts, no tracking without consent</li><li>One search intent for each service page</li></ul>
          <p class="mini-text mk-card-link"><a class="text-link" href="/services/seo-services/">How the SEO work is done</a></p>
        </article>
      </div>
    </div>
  </section>

  <section class="page-section" id="one-person" aria-labelledby="one-title">
    <div class="wrap">
      <p class="section-tag">02 · The difference</p>
      <h2 class="block-title" id="one-title">Why hire one person who markets, builds and edits?</h2>
      <div class="body-copy mk-two">
        <p>Small-business marketing usually fails in the gaps between jobs. The ad is good but the page is slow. The page is clear but it does not match the reel. The reel works, but nobody counted the WhatsApp messages it brought in. When three freelancers share the work, each gap belongs to someone else.</p>
        <p>I run the whole loop myself. When a campaign underperforms, I can rewrite the landing page the same day, re-cut the reel and check the numbers again, without waiting on a developer or an editor.</p>
      </div>
      <ol class="mk-loop" aria-label="The marketing loop">
        {loop.map((step, index) => <li><span class="mk-loop-num" aria-hidden="true">{pad(index + 1)}</span><h3 class="mini-title">{step.title}</h3><p class="mini-text">{step.text}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="page-section" id="services" aria-labelledby="services-title">
    <div class="wrap">
      <p class="section-tag">03 · Services</p>
      <h2 class="block-title" id="services-title">Digital marketing services, start to finish</h2>
      <p class="block-desc">Pick one or combine them. Each comes with a written scope before work starts.</p>
      <ul class="mk-services">
        {marketingServices.map((item) => (
          <li class="card">
            <h3 class="mini-title"><a class="text-link" href={item.href}>{item.title}</a></h3>
            <p class="mini-text">{item.text}</p>
            <ul class="spec-list">{item.items.map((line) => <li>{line}</li>)}</ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="page-section" id="health-check" aria-labelledby="hc-title">
    <div class="wrap">
      <p class="section-tag">04 · Free check</p>
      <h2 class="block-title" id="hc-title">Score your marketing in 60 seconds</h2>
      <p class="block-desc">Ten yes-or-no questions about your business. You get a score out of 100 and the three fixes I would make first. Nothing is stored or sent unless you choose to send it.</p>
      <form class="mk-hc" data-hc data-email={profile.email} data-whatsapp={profile.whatsapp} data-bands={JSON.stringify(scoreBands)} data-state="empty" novalidate>
        <ol class="mk-hc-list">
          {healthQuestions.map((item, index) => (
            <li>
              <fieldset class="mk-hc-item" data-weight={item.weight} data-q={item.q} data-fix={item.fix} data-href={item.href}>
                <legend><span class="mk-hc-num" aria-hidden="true">{pad(index + 1)}</span><span>{item.q}</span></legend>
                <div class="mk-hc-options">
                  <label><input type="radio" name={item.id} value="yes" /><span>Yes</span></label>
                  <label><input type="radio" name={item.id} value="no" /><span>No</span></label>
                  <label><input type="radio" name={item.id} value="unsure" /><span>Not sure</span></label>
                </div>
              </fieldset>
            </li>
          ))}
        </ol>
        <div class="mk-hc-result" aria-live="polite">
          <div class="mk-ring" data-hc-ring><span><strong data-hc-score>–</strong><small>/100</small></span></div>
          <p class="mk-hc-progress note" data-hc-progress>0 of 10 answered</p>
          <h3 class="mk-hc-band" data-hc-band>Turn on JavaScript to see your score</h3>
          <p class="mini-text" data-hc-text>Or count your answers: each “No” is a fix worth making.</p>
          <ol class="mk-hc-fixes" data-hc-fixes></ol>
          <div class="mk-hc-actions">
            <a class="btn btn-red" data-hc-send data-cta="mk_check_send" href={`mailto:${profile.email}?subject=Marketing%20check`}>Email me this result</a>
            {profile.whatsapp && <a class="btn btn-glass" data-hc-whatsapp href={`https://wa.me/${profile.whatsapp}`} target="_blank" rel="noopener noreferrer">Send on WhatsApp</a>}
            <button type="button" class="btn btn-glass mk-js" data-hc-reset>Start again</button>
          </div>
        </div>
      </form>
    </div>
  </section>

  <section class="page-section" id="checklist" aria-labelledby="checks-title">
    <div class="wrap">
      <p class="section-tag">05 · How to choose</p>
      <h2 class="block-title" id="checks-title">How to choose the best freelance digital marketer in Calicut: 10 checks</h2>
      <p class="block-desc">Use these on anyone you are considering. Each check comes with my own answer, so you can hold me to it.</p>
      <ol class="mk-checks">
        {checks.map((item, index) => (
          <li class="card">
            <span class="mk-check-num" aria-hidden="true">{pad(index + 1)}</span>
            <h3 class="mini-title">{item.title}</h3>
            <p class="mini-text">{item.check}</p>
            <p class="mk-mine"><b>My answer:</b> {item.mine}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="page-section" id="process" aria-labelledby="month-title">
    <div class="wrap">
      <p class="section-tag">06 · Process</p>
      <h2 class="block-title" id="month-title">What the first 30 days look like</h2>
      <p class="block-desc">Foundations come before promotion. This is the usual order.</p>
      <ol class="mk-month">
        {firstMonth.map((step) => <li><span class="mk-week">{step.week}</span><h3 class="mini-title">{step.title}</h3><p class="mini-text">{step.text}</p></li>)}
      </ol>
      <p class="mini-text mk-after">After the first month the cycle repeats: measure, fix what leaks and make more of what works. You get a plain-language report every month.</p>
    </div>
  </section>

  <section class="page-section" id="calicut" aria-labelledby="local-title">
    <div class="wrap">
      <p class="section-tag">07 · Local knowledge</p>
      <h2 class="block-title" id="local-title">Marketing that fits how Calicut buys</h2>
      <p class="block-desc">Calicut runs on trust, recommendations and quick replies. Marketing here works when it fits how people already buy.</p>
      <ul class="mk-local">{localPoints.map((item) => <li><h3 class="mini-title">{item.title}</h3><p class="mini-text">{item.text}</p></li>)}</ul>
      <p class="mini-text mk-areas">I’m based in Kozhikode and take on businesses anywhere in the district, from the city centre to Feroke, Ramanattukara, Koyilandy, Vadakara and Thamarassery, as well as Malappuram, Wayanad and Kannur. Clients elsewhere in Kerala, India and the GCC work with me remotely. See <a class="text-link" href="/locations/kozhikode/">working with clients in Kozhikode</a>.</p>
    </div>
  </section>

  <section class="page-section" id="compare" aria-labelledby="compare-title">
    <div class="wrap">
      <p class="section-tag">08 · Compare</p>
      <h2 class="block-title" id="compare-title">Freelancer, agency or do it yourself?</h2>
      <p class="block-desc">An honest comparison. If you need many specialists at the same time, an agency is the better choice.</p>
      <div class="mk-table-wrap">
        <table class="mk-table">
          <caption class="sr-only">Freelance digital marketer compared with an agency and doing it yourself</caption>
          <thead><tr><th scope="col"><span class="sr-only">Question</span></th><th scope="col">Freelance digital marketer</th><th scope="col">Agency</th><th scope="col">Do it yourself</th></tr></thead>
          <tbody>{compareRows.map((row) => <tr><th scope="row">{row.label}</th><td data-label="Freelancer">{row.freelancer}</td><td data-label="Agency">{row.agency}</td><td data-label="Yourself">{row.diy}</td></tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="page-section" id="pricing" aria-labelledby="price-title">
    <div class="wrap">
      <p class="section-tag">09 · Pricing</p>
      <h2 class="block-title" id="price-title">How much does a freelance digital marketer in Calicut cost?</h2>
      <p class="block-desc">Prices depend on scope, so instead of a made-up rate card, here is how quotes are built.</p>
      <ul class="mk-prices">{priceModels.map((item) => <li class="card"><h3 class="mini-title">{item.title}</h3><p class="mini-text">{item.text}</p></li>)}</ul>
      <p class="mini-text mk-after">Every quote is written for the exact scope before work starts. Ad budgets are always kept separate from fees. <a class="text-link" href={contactHref} data-cta="mk_pricing_quote">Ask for a quote</a></p>
    </div>
  </section>

  <section class="page-section" id="about" aria-labelledby="about-title">
    <div class="wrap mk-about">
      <div class="mk-about-photo">
        <div class="portrait">
          <div class="portrait-panel" aria-hidden="true"></div>
          <img class="portrait-img" src="/images/portrait.webp" srcset="/images/portrait-420.webp 420w, /images/portrait.webp 760w" sizes="(max-width: 860px) 300px, 360px" alt="Black and white illustrated portrait used by Salman Faris" width="760" height="950" loading="lazy" decoding="async" />
        </div>
      </div>
      <div class="body-copy">
        <p class="section-tag">10 · About</p>
        <h2 class="block-title" id="about-title">About Salman Faris, freelance digital marketer in Kozhikode</h2>
        <p>I build websites and software, edit video and motion graphics, and bring both into marketing. I write the plan, build the pages, edit the videos and read the numbers, so the work that brings enquiries gets more attention and the rest gets fixed or dropped.</p>
        <p>Most of my work is public. My code is on <a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a>, my reels are on <a class="text-link" href={profile.instagram} target="_blank" rel="noopener noreferrer">Instagram as {profile.instagramHandle}</a>, and the case studies on this site show how each project was built, including what is still unfinished.</p>
        <p>Read more <a class="text-link" href="/about/">about me</a>, see the full <a class="text-link" href="/services/">list of services</a>, or connect on <a class="text-link" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>.</p>
        {credentials.length > 0 && (
          <div class="mk-proof-list">
            <h3 class="mini-title">Certifications</h3>
            <ul class="spec-list">{credentials.map((c) => <li><a class="text-link" href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a>, {c.issuer}, {c.year}</li>)}</ul>
          </div>
        )}
        {clients.length > 0 && (
          <div class="mk-proof-list">
            <h3 class="mini-title">Businesses I have worked with</h3>
            <ul class="spec-list">{clients.map((c) => <li><a class="text-link" href={c.url} target="_blank" rel="noopener noreferrer">{c.name}</a>: {c.work}</li>)}</ul>
          </div>
        )}
      </div>
    </div>
  </section>

  {reviews.length > 0 && (
    <section class="page-section" id="reviews" aria-labelledby="reviews-title">
      <div class="wrap">
        <h2 class="block-title" id="reviews-title">What clients say</h2>
        <ul class="grid-3">{reviews.map((r) => <li class="card"><blockquote class="quote"><p>{r.quote}</p></blockquote><p class="mini-text mk-after"><strong>{r.name}</strong>, {r.business} · <a class="text-link" href={r.source} target="_blank" rel="noopener noreferrer">Source</a> · {r.date}</p></li>)}</ul>
      </div>
    </section>
  )}

  <section class="page-section" id="faq" aria-labelledby="faq-title">
    <div class="wrap">
      <p class="section-tag">Questions</p>
      <h2 class="block-title" id="faq-title" style="margin-bottom:20px">Questions people ask before hiring a digital marketer in Calicut</h2>
      <FaqList faqs={marketerFaqs} />
    </div>
  </section>

  <section class="page-section"><div class="wrap"><ContactBlock tag="NEXT STEP" title="Want marketing you can check?" text="Send your website and what you sell. You will get questions back first, then a written plan." headingId="cta-title" /></div></section>
</PageShell>

<script>import '../scripts/marketer';</script>

<style>
  @property --score { syntax: '<number>'; inherits: false; initial-value: 0; }

  .mk-hero { padding-bottom: 24px; }
  .mk-hero-grid { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, .85fr); gap: clamp(28px, 4vw, 64px); align-items: start; }
  .mk-hero-main { min-width: 0; }
  .mk-title { font-size: clamp(34px, 5vw, 64px); font-weight: 800; letter-spacing: -.035em; line-height: 1.06; color: var(--white); margin-bottom: 20px; max-width: 18ch; }
  .mk-title em { font-style: normal; color: var(--red); }
  .mk-facts { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 26px; }
  .mk-facts li { font: 600 12px/1.4 var(--mono); color: var(--soft); padding: 6px 12px; border: 1px solid var(--line-strong); border-radius: 999px; }
  .mk-answer { margin-top: 26px; padding: 18px 20px; border-left: 3px solid var(--red); background: rgba(255, 255, 255, .03); max-width: 70ch; }
  .mk-answer-label { font: 700 11px/1.4 var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--red); margin-bottom: 6px; }
  .mk-answer p:last-child { color: var(--text); font-size: 16px; line-height: 1.7; }

  .mk-panel { min-width: 0; margin-top: 44px; background: linear-gradient(180deg, rgba(20, 20, 20, .9), rgba(8, 8, 8, .95)); border: 1px solid var(--red-line); border-radius: 12px; padding: 22px; box-shadow: 0 0 40px rgba(239, 68, 68, .08); }
  .mk-panel-head { display: flex; justify-content: space-between; align-items: center; font: 700 11px/1 var(--mono); letter-spacing: .12em; color: var(--dim); padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .mk-live { display: inline-flex; align-items: center; gap: 8px; color: var(--red); text-transform: uppercase; }
  .mk-meter { display: grid; gap: 4px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .mk-meter-label { font: 600 12px/1.4 var(--mono); color: var(--muted); }
  .mk-meter-value { font: 400 clamp(48px, 5vw, 64px)/1 var(--display); color: var(--white); letter-spacing: .01em; }
  .mk-meter[data-live='true'] .mk-meter-value { color: var(--red); }
  .mk-meter-sub { font-size: 12px; color: var(--dim); }
  .mk-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--line); margin: 18px 0; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
  .mk-stats div { background: #0a0a0a; padding: 12px 14px; display: flex; flex-direction: column-reverse; gap: 4px; min-width: 0; }
  .mk-stats dt { font-size: 12px; color: var(--muted); line-height: 1.4; }
  .mk-stats dd { font: 700 22px/1.1 var(--mono); color: var(--white); }
  .mk-person { display: flex; align-items: center; gap: 14px; }
  .mk-person img { width: 56px; height: 56px; object-fit: cover; border-radius: 50%; border: 1px solid var(--red-line); background: #111; flex: none; }
  .mk-person p { display: grid; gap: 2px; font-size: 13px; color: var(--muted); line-height: 1.4; }
  .mk-person strong { color: var(--white); font-size: 15px; }

  .mk-site-card { display: flex; flex-direction: column; gap: 10px; }
  .mk-site-card .chip { width: fit-content; }
  .mk-card-link { margin-top: auto; padding-top: 6px; }

  .mk-two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 32px; margin-top: 12px; }
  .mk-loop { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; margin-top: 24px; counter-reset: loop; }
  .mk-loop li { position: relative; padding: 20px; border: 1px solid var(--line); border-radius: 12px; background: var(--card); min-width: 0; }
  .mk-loop li:not(:last-child)::after { content: '→'; position: absolute; right: -14px; top: 22px; width: 14px; text-align: center; color: var(--red); font: 700 14px/1 var(--mono); }
  .mk-loop-num { display: block; font: 700 12px/1 var(--mono); color: var(--red); margin-bottom: 12px; }

  .mk-services { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .mk-services > li { display: flex; flex-direction: column; gap: 10px; min-width: 0; padding: 22px; }

  .mk-hc { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 24px; align-items: start; }
  .mk-hc-list { display: grid; gap: 10px; counter-reset: none; }
  .mk-hc-item { border: 1px solid var(--line); border-radius: 12px; padding: 16px 18px; background: var(--card); min-width: 0; transition: border-color var(--fast); }
  .mk-hc-item[data-answer='yes'] { border-color: rgba(255, 255, 255, .3); }
  .mk-hc-item[data-answer='no'], .mk-hc-item[data-answer='unsure'] { border-color: var(--red-line); }
