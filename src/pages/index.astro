---
import Layout from '../layouts/Layout.astro';
import ContactBlock from '../components/ContactBlock.astro';
import Dock from '../components/Dock.astro';
import Footer from '../components/Footer.astro';
import Toast from '../components/Toast.astro';
import About from '../components/home/About.astro';
import Faq from '../components/home/Faq.astro';
import Flagships from '../components/home/Flagships.astro';
import Courses from '../components/home/Courses.astro';
import Hero from '../components/home/Hero.astro';
import Insights from '../components/home/Insights.astro';
import Matrix from '../components/home/Matrix.astro';
import Process from '../components/home/Process.astro';
import Services from '../components/home/Services.astro';
import Stack from '../components/home/Stack.astro';
import { homeFaqs } from '../data/faqs';
import { alternatesFor } from '../data/i18n';
import { faqNode, webPageNode } from '../lib/schema';
import '../styles/build-intro.css';

const pageTitle = 'Salman Faris | Full Stack Developer, AI Web Developer & Video Editor';
const pageDescription = 'Salman Faris is a full-stack developer, AI web developer and video editor in Calicut, Kerala. Websites, AI automation, SEO and motion design for businesses.';
const structuredData = [
  webPageNode('/', pageTitle, pageDescription, { mainEntity: { '@id': 'https://www.salmanfaris.in/#person' } }, 'ProfilePage'),
  faqNode('/', homeFaqs),
];
---
<Layout pageTitle={pageTitle} pageDescription={pageDescription} structuredData={structuredData} alternates={alternatesFor('home')}>
  <link slot="head" rel="preload" as="image" type="image/webp" href="/images/portrait.webp" imagesrcset="/images/portrait-420.webp 420w, /images/portrait.webp 760w" imagesizes="(max-width: 480px) 160px, 380px" fetchpriority="high" />
  <canvas id="aurora" aria-hidden="true"></canvas>
  <Dock home />
  <main id="main">
    <Hero />
    <About />
    <Services />
    <Flagships />
    <Matrix />
    <Stack />
    <Courses />
    <Process />
    <Insights />
    <Faq />
    <section id="contact" class="section" aria-labelledby="contact-title">
      <div class="wrap"><ContactBlock /></div>
    </section>
  </main>
  <Footer home />
  <Toast />
  <script>import '../scripts/site';</script>
  <script>import '../scripts/build-intro';</script>
</Layout>
