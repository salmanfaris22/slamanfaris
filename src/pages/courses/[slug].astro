---
import { coursePayment } from '../../lib/course-payment';
import FaqList from '../../components/FaqList.astro';
import PageHero from '../../components/PageHero.astro';
import { courses, isIndexable, statusLabel, type Course } from '../../data/courses';
import { profile } from '../../data/portfolio';
import PageShell from '../../layouts/PageShell.astro';
import { serviceBySlug } from '../../lib/services';
import { absolute, breadcrumbNode, faqNode, PERSON_ID, webPageNode } from '../../lib/schema';

export function getStaticPaths() {
  return courses.map((course) => ({ params: { slug: course.slug }, props: { course } }));
}

const { course } = Astro.props as { course: Course };
const path = `/courses/${course.slug}/`;
const title = `${course.title} Course | Salman Faris`;
const description = `${course.short} ${statusLabel[course.status]}. Syllabus, projects and how to enquire, from Salman Faris in Calicut, Kerala.`.slice(0, 165);
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Courses', path: '/courses/' }, { name: course.title, path }];
const indexable = isIndexable(course);
const payment = coursePayment(course);
const proposed = course.status === 'planned';
const enquireHref = `/contact/?course=${encodeURIComponent(course.title)}#course`;
const facts = [
  course.duration && ['Duration', course.duration],
  course.deliveryModes.length ? ['Format', course.deliveryModes.join(', ')] : null,
  course.fee && ['Fee', course.fee],
  course.batches && ['Batches', course.batches],
].filter(Boolean) as [string, string][];
const structuredData: Record<string, unknown>[] = [
  webPageNode(path, title, description),
  breadcrumbNode(path, crumbs),
  faqNode(path, course.faqs),
];
if (indexable) structuredData.push({
  '@type': 'Course',
  '@id': `${absolute(path)}#course`,
  name: course.title,
  description: course.description,
  url: absolute(path),
  inLanguage: 'en',
  provider: { '@id': PERSON_ID },
  teaches: course.outcomes,
  coursePrerequisites: course.prerequisites,
});
---
<PageShell pageTitle={title} pageDescription={description} structuredData={structuredData} noindex={!indexable}>
  <span data-view-event="course_view" data-view-label={course.slug} hidden></span>
  <PageHero crumbs={crumbs} tag={course.category} title={course.title} lead={course.short}>
    <p class="chip" style="margin-top:18px"><span aria-hidden="true">●</span> {statusLabel[course.status]}</p>
    {proposed && <p class="note" style="margin-top:12px">This is a proposed course. The outline below may change, and no batch is open yet.</p>}
    {course.status === 'confirm' && <p class="note" style="margin-top:12px">Batch dates, fees and final details are confirmed directly. Send an enquiry to get them.</p>}
    <div class="page-actions">
      {payment && <a class="btn btn-red" href={payment} data-cta={`enrol_${course.slug}`} rel="noopener">Enrol with Razorpay</a>}
      <a class:list={['btn', payment ? 'btn-glass' : 'btn-red']} href={enquireHref} data-cta={`course_${course.slug}`}>{proposed ? 'Register interest' : 'Enquire about this course'}</a>
      <a class="btn btn-glass" href="#syllabus">View syllabus</a>
    </div>
  </PageHero>

  <div class="wrap"><img src={`/images/courses/${course.slug}.svg`} alt={`${course.title} course artwork`} width="720" height="405" style="width:100%;max-width:720px;height:auto;border-radius:20px" /></div>

  <section class="page-section" aria-labelledby="overview-title">
    <div class="wrap about-grid">
      <div class="body-copy">
        <h2 class="block-title" id="overview-title">About this course</h2>
        <p>{course.description}</p>
        <h3 class="explorer-title" style="margin:24px 0 10px">WHO SHOULD JOIN</h3>
        <ul class="spec-list" style="font-size:15px">{course.forWho.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div>
        <h2 class="block-title">What you will be able to do</h2>
        <ul class="spec-list" style="font-size:15px;margin-top:14px">{course.outcomes.map((item) => <li>{item}</li>)}</ul>
        {facts.length > 0 && (
          <div class="metrics" style="margin:24px 0 0">{facts.map(([label, value]) => <div class="metric"><div class="metric-value" style="font-size:16px">{value}</div><div class="metric-label">{label}</div></div>)}</div>
        )}
      </div>
    </div>
  </section>

  <section class="page-section" aria-labelledby="join-title">
    <div class="wrap">
      <h2 class="block-title" id="join-title" style="margin-bottom:20px">Join from Calicut, India or anywhere</h2>
      <div class="grid-3">
        <div class="card"><h3 class="mini-title">In Calicut</h3><p class="mini-text">Offline batches in Kozhikode run only when confirmed. Ask before you plan around one.</p></div>
        <div class="card"><h3 class="mini-title">Across India</h3><p class="mini-text">Online learning means you can join from any state with a laptop and stable internet.</p></div>
        <div class="card"><h3 class="mini-title">Worldwide</h3><p class="mini-text">Learners in the Gulf and elsewhere can join online. Live sessions run on India Standard Time (UTC+5:30).</p></div>
      </div>
    </div>
  </section>

  <section class="page-section" aria-labelledby="journey-title">
    <div class="wrap">
      <h2 class="block-title" id="journey-title" style="margin-bottom:16px">Your learning journey</h2>
      <ol class="tag-row">{course.journey.map((step, index) => <li class="tech-tag">{index + 1}. {step}</li>)}</ol>
    </div>
  </section>

  <section class="page-section" id="syllabus" aria-labelledby="syllabus-title">
    <div class="wrap">
      <h2 class="block-title" id="syllabus-title">{proposed ? 'Proposed syllabus' : 'Syllabus'}</h2>
      <p class="block-desc">{course.modules.length} modules, in order.</p>
      <ol class="grid-3">
        {course.modules.map((module, index) => (
          <li class="card">
            <p class="layer-badge">MODULE {String(index + 1).padStart(2, '0')}</p>
            <h3 class="mini-title">{module.title}</h3>
            <ul class="spec-list" style="margin-top:10px">{module.topics.map((topic) => <li>{topic}</li>)}</ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="page-section" aria-labelledby="projects-title">
    <div class="wrap about-grid">
      <div>
        <h2 class="block-title" id="projects-title">What you will build</h2>
        <ul class="spec-list" style="font-size:15px;margin-top:14px">{course.projects.map((item) => <li>{item}</li>)}</ul>
        <h3 class="explorer-title" style="margin:28px 0 10px">PREREQUISITES</h3>
        <ul class="spec-list" style="font-size:15px">{course.prerequisites.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div>
        <h2 class="block-title">Tools</h2>
        <div class="tag-row" style="margin-top:14px">{course.tools.map((tool) => <span class="tech-tag">{tool}</span>)}</div>
        <h2 class="block-title" style="margin-top:32px">Your instructor</h2>
        <p class="mini-text" style="font-size:15px;margin-top:8px">{profile.name} is a full-stack developer and video editor based in Calicut. <a class="text-link" href="/about/">Read his profile</a> or see <a class="text-link" href="/projects/">his projects</a>.</p>
        {course.relatedServices.length > 0 && <p class="mini-text" style="margin-top:12px">Need this done for your business instead? See <a class="text-link" href={`/services/${course.relatedServices[0]}/`}>{serviceBySlug(course.relatedServices[0]).name}</a>.</p>}
      </div>
    </div>
  </section>

  <section class="page-section" aria-labelledby="faq-title">
    <div class="wrap">
      <h2 class="block-title" id="faq-title" style="margin-bottom:20px">Common questions</h2>
      <FaqList faqs={course.faqs} />
      <div class="page-actions"><a class="btn btn-red" href={enquireHref} data-cta={`course_${course.slug}_footer`}>{proposed ? 'Register interest' : 'Enquire about this course'}</a></div>
    </div>
  </section>
</PageShell>
