---
import PageHero from '../../components/PageHero.astro';
import CourseCatalogue from '../../components/CourseCatalogue.astro';
import FaqList from '../../components/FaqList.astro';
import { learningFaqs } from '../../data/faqs';
import { courses, isIndexable } from '../../data/courses';
import PageShell from '../../layouts/PageShell.astro';
import { absolute, breadcrumbNode, faqNode, webPageNode } from '../../lib/schema';
import { mentorshipPayment } from '../../lib/course-payment';
import { alternatesFor } from '../../data/i18n';
const path = '/courses/';
const title = 'AI, Web, Marketing and Video Courses | Salman Faris';
const description = 'Explore AI, reel automation, web development, video editing, design and marketing courses with Salman Faris. View outlines, course status and mentorship options.';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Courses', path }];
const structuredData = [webPageNode(path, title, description, { mainEntity: { '@type': 'ItemList', itemListElement: courses.filter(isIndexable).map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.title, url: absolute(`/courses/${c.slug}/`) })) } }, 'CollectionPage'), breadcrumbNode(path, crumbs), faqNode(path, learningFaqs)];
---
<PageShell pageTitle={title} pageDescription={description} structuredData={structuredData} alternates={alternatesFor('courses')}>
  <PageHero crumbs={crumbs} tag="LEARN WITH SALMAN" title="Learn the skills clients pay for" lead="Make your next idea a real project. Explore courses in AI, editing, web development, design and marketing — with clear outlines and an honest status for every course.">
    <div class="page-actions"><a class="btn btn-red" href="#catalogue">Browse courses ↗</a><a class="btn btn-glass" href="#mentorship">Explore mentorship</a></div>
  </PageHero>
  <section class="page-section" id="catalogue" aria-labelledby="catalogue-title"><div class="wrap">
    <nav class="learning-nav" aria-label="Learning sections"><a href="#catalogue">Courses</a><a href="#features">Features</a><a href="#trainers">Trainer</a><a href="#mentorship">Mentorship</a><a href="#course-faq">FAQ</a></nav>
    <h2 class="block-title" id="catalogue-title">Find your next skill</h2><p class="block-desc">Choose a topic, explore the syllabus and check availability before enrolling.</p>
    <CourseCatalogue />
  </div></section>
  <section class="page-section" id="features" aria-labelledby="features-title"><div class="wrap"><p class="layer-badge">LEARN BY MAKING</p><h2 class="block-title" id="features-title">From a lesson to something you can show.</h2><div class="grid-3" style="margin-top:28px">
    <article class="card"><span class="chip">01 / PRACTICE</span><h3 class="mini-title" style="margin-top:18px">Projects with a purpose</h3><p class="mini-text">Explore practical outcomes: a deployed website, a finished reel or a clickable design prototype.</p></article>
    <article class="card"><span class="chip">02 / YOUR PATH</span><h3 class="mini-title" style="margin-top:18px">Know what comes next</h3><p class="mini-text">Read the modules, prerequisites and tools before choosing your course.</p></article>
    <article class="card"><span class="chip">03 / GUIDANCE</span><h3 class="mini-title" style="margin-top:18px">Ask for a second pair of eyes</h3><p class="mini-text">Enquire about mentorship for project feedback, portfolio reviews and choosing your next step.</p></article>
  </div></div></section>
  <section class="page-section" id="trainers" aria-labelledby="trainer-title"><div class="wrap trainer-card"><img src="/images/portrait.webp" width="760" height="760" loading="lazy" alt="Salman Faris, developer and video editor"/><div><p class="layer-badge">MEET YOUR TRAINER</p><h2 class="block-title" id="trainer-title">Hi, I’m Salman.</h2><p class="block-desc">A full-stack developer and video editor in Calicut. My work connects websites, AI workflows, motion design and the practical decisions behind shipping a project.</p><div class="tag-row"><span class="tech-tag">Development</span><span class="tech-tag">AI workflows</span><span class="tech-tag">Video & motion</span></div><div class="page-actions"><a class="btn btn-glass" href="/about/">Meet Salman</a><a class="text-link" href="/projects/">See the work ↗</a></div></div></div></section>
  <section class="page-section" id="mentorship" aria-labelledby="mentorship-title"><div class="wrap"><div class="card mentorship"><p class="layer-badge">ONE TO ONE</p><h2 class="block-title" id="mentorship-title">Your project. A clearer next step.</h2><p class="block-desc">Bring a website, reel, portfolio or an idea you are stuck on. Enquire about a focused review and agree the scope, session time and fee before booking.</p><div class="tag-row"><span class="tech-tag">Portfolio review</span><span class="tech-tag">Project feedback</span><span class="tech-tag">AI workflow guidance</span></div><div class="page-actions"><a class="btn btn-red" href={mentorshipPayment || '/contact/?course=One-to-one%20mentorship#course'}>{mentorshipPayment ? 'Book mentorship with Razorpay' : 'Ask about mentorship'}</a><a class="btn btn-glass" href="/services/">Need it done for you?</a></div></div></div></section>
  <section class="page-section" id="course-faq" aria-labelledby="course-faq-title"><div class="wrap"><h2 class="block-title" id="course-faq-title" style="margin-bottom:24px">Before you get started</h2><FaqList faqs={learningFaqs}/></div></section>
</PageShell>
<style>
.learning-nav{display:flex;gap:24px;flex-wrap:wrap;padding-bottom:28px;margin-bottom:28px;border-bottom:1px solid #ffffff20;font-size:14px}.learning-nav a{text-decoration:none}.trainer-card{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:50px;align-items:center}.trainer-card img{width:100%;max-height:380px;object-fit:cover;border-radius:24px;background:#17171c}.mentorship{padding:clamp(24px,5vw,60px);background:linear-gradient(120deg,#29151b,#111216);border-color:#ef444440}.mentorship .block-desc{max-width:720px}@media(max-width:700px){.trainer-card{grid-template-columns:1fr;gap:24px}.trainer-card img{max-width:280px}}
</style>
