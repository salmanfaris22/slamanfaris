---
import PageShell from '../layouts/PageShell.astro';
---
<PageShell pageTitle="Page not found | Salman Faris" pageDescription="This page does not exist. Go back to the Salman Faris portfolio to see his work and services." noindex={true}>
  <section class="page-hero" style="min-height:70vh;display:flex;align-items:center">
    <div class="wrap">
      <p class="section-tag">ERROR 404</p>
      <h1 class="page-title">This page moved or never existed.</h1>
      <p class="page-lead">Try the home page, browse the services, or get in touch directly.</p>
      <div class="page-actions"><a class="btn btn-red" href="/">Back to home</a><a class="btn btn-glass" href="/services/">See services</a><a class="btn btn-glass" href="/contact/">Contact</a></div>
    </div>
  </section>
</PageShell>
