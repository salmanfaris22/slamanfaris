---
import ContactBlock from '../../components/ContactBlock.astro';
import FaqList from '../../components/FaqList.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { courses, isIndexable } from '../../data/courses';
import { projectById } from '../../data/portfolio';
import { SERVICE_AREAS, type Service } from '../../data/services/types';
import PageShell from '../../layouts/PageShell.astro';
import { serviceBySlug, services } from '../../lib/services';
import { breadcrumbNode, faqNode, serviceNode, webPageNode } from '../../lib/schema';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props as { service: Service };
const path = `/services/${service.slug}/`;
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Services', path: '/services/' }, { name: service.name, path }];
const proof = service.proof.map(projectById);
const related = service.related.map(serviceBySlug);
const relatedCourses = courses.filter((course) => isIndexable(course) && course.relatedServices.includes(service.slug));
const structuredData = [
  webPageNode(path, service.seoTitle, service.description),
  serviceNode(path, service.h1, service.description, SERVICE_AREAS),
  breadcrumbNode(path, crumbs),
  faqNode(path, service.faqs),
];
---
<PageShell pageTitle={service.seoTitle} pageDescription={service.description} structuredData={structuredData}>
  <span data-view-event="service_view" data-view-label={service.slug} hidden></span>
  <PageHero crumbs={crumbs} tag={service.tag} title={service.h1}>
    <blockquote class="quote answer"><p>{service.answer}</p></blockquote>
    <div class="page-actions">
      <a class="btn btn-red" href={`/contact/?service=${encodeURIComponent(service.name)}#project`} data-cta={`service_${service.slug}`}>{service.cta.label}</a>
      <a class="btn btn-glass" href="#examples">See examples</a>
    </div>
  </PageHero>

  <section class="page-section" aria-labelledby="intro-title">
    <div class="wrap about-grid">
      <div class="body-copy">
        <h2 class="block-title" id="intro-title">Who this is for</h2>
        <p>{service.audience}</p>
        {service.intro.map((text) => <p>{text}</p>)}
      </div>
      <div>
        <h2 class="block-title">Problems this solves</h2>
        <ul class="steps" style="margin-top:16px">
          {service.problems.map((item) => <li><h3 class="mini-title">{item.title}</h3><p class="mini-text">{item.text}</p></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="page-section" aria-labelledby="offers-title">
    <div class="wrap">
      <h2 class="block-title" id="offers-title">What I offer</h2>
      <p class="block-desc">Agreed in writing before work starts.</p>
      <ul class="grid-3">{service.offers.map((item) => <li class="card"><h3 class="mini-title">{item.title}</h3><p class="mini-text">{item.text}</p></li>)}</ul>
      <h3 class="explorer-title" style="margin:32px 0 12px">TOOLS AND TECHNOLOGY</h3>
      <div class="tag-row">{service.tools.map((tool) => <span class="tech-tag">{tool}</span>)}</div>
    </div>
  </section>

  <section class="page-section" id="examples" aria-labelledby="examples-title">
    <div class="wrap">
      <h2 class="block-title" id="examples-title">Project examples</h2>
      <p class="block-desc">Real work where it exists, and clearly labelled concepts where it does not.</p>
      <div class="bento-grid">{proof.map((project) => <ProjectCard project={project} />)}</div>
    </div>
  </section>

  <section class="page-section" aria-labelledby="process-title">
    <div class="wrap about-grid">
      <div>
        <h2 class="block-title" id="process-title">How it works</h2>
        <ol class="steps" style="margin-top:16px">
          {service.process.map((step, index) => <li class="step"><span class="step-num" aria-hidden="true">0{index + 1}</span><div><h3 class="step-title">{step.title}</h3><p class="step-text">{step.text}</p></div></li>)}
        </ol>
      </div>
      <div>
        <h2 class="block-title">What you get</h2>
        <ul class="spec-list" style="margin-top:16px;font-size:15px">{service.deliverables.map((item) => <li>{item}</li>)}</ul>
        <h2 class="block-title" style="margin-top:36px">Where I work</h2>
        <p class="mini-text" style="font-size:15px;margin-top:8px">{service.local}</p>
        <p class="mini-text" style="margin-top:10px"><a class="text-link" href="/locations/kozhikode/">Working with clients in Kozhikode</a></p>
      </div>
    </div>
  </section>

  <section class="page-section" aria-labelledby="faq-title">
    <div class="wrap">
      <h2 class="block-title" id="faq-title" style="margin-bottom:20px">Common questions</h2>
      <FaqList faqs={service.faqs} />
    </div>
  </section>

  <section class="page-section" aria-labelledby="related-title">
    <div class="wrap">
      <h2 class="block-title" id="related-title" style="margin-bottom:20px">Related services</h2>
      <ul class="bento-grid">
        {related.map((item) => <li class="card"><h3 class="mini-title"><a class="text-link" href={`/services/${item.slug}/`}>{item.h1}</a></h3><p class="mini-text">{item.audience}</p></li>)}
        {relatedCourses.map((course) => <li class="card"><h3 class="mini-title"><a class="text-link" href={`/courses/${course.slug}/`}>{course.title} course</a></h3><p class="mini-text">{course.short}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="page-section"><div class="wrap"><ContactBlock tag="NEXT STEP" title={service.cta.title} text={service.cta.text} headingId="cta-title" /></div></section>
</PageShell>
