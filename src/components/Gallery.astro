---
import { projects } from '../data/portfolio';
---
<div id="project-gallery">
  <div class="work-rail" aria-label="Selected projects">
    {projects.map(p=><article class="project-card"><a class="project-open" href={`/projects/${p.id}/`}><div class="project-image"><img src={p.image} width="1200" height="850" alt={`${p.title} — illustrative concept artwork`} loading="lazy"/><span class="project-concept mono">CONCEPT PROJECT</span></div><div class="project-meta mono">{p.discipline}</div><div class="project-title"><h3>{p.title}</h3><span>↗</span></div></a></article>)}
  </div>
</div>
<script>
  import { createElement } from 'react';
  import { createRoot } from 'react-dom/client';
  import ProjectGallery from './ProjectGallery';
  const container = document.getElementById('project-gallery');
  if (container) createRoot(container).render(createElement(ProjectGallery));
</script>
