---
import SectionHead from '../SectionHead.astro';
import CourseCatalogue from '../CourseCatalogue.astro';
import { mentorshipPayment } from '../../lib/course-payment';
---
<section id="courses" class="section" aria-labelledby="courses-title">
  <div class="wrap">
    <SectionHead tag="LESS SCROLLING. MORE CREATING." title="Learn the skills clients pay for" id="courses-title" desc="AI, web development, video editing and marketing. Explore practical course outlines and find your next skill." />
    <nav class="learn-nav" aria-label="Learning sections"><a href="#courses">Courses</a><a href="/courses/#features">Features</a><a href="/courses/#trainers">Trainer</a><a href="#services">Services</a><a href="#faq">FAQ</a></nav>
    <CourseCatalogue />
    <div class="mentorship-strip"><div><span class="chip">A LITTLE DIRECTION GOES A LONG WAY</span><h3>Building something? Let’s work through it.</h3><p>Ask about one-to-one mentorship, a portfolio review or help planning your next project.</p></div><a class="btn btn-red" href={mentorshipPayment || '/contact/?course=One-to-one%20mentorship#course'}>{mentorshipPayment ? 'Book mentorship · Razorpay' : 'Ask about mentorship'} <span aria-hidden="true">↗</span></a></div>
    <p style="margin-top:24px"><a class="text-link" href="/courses/">Explore courses, learning features and your trainer →</a></p>
  </div>
</section>
<style>
.learn-nav{display:flex;gap:25px;flex-wrap:wrap;margin-bottom:28px;font-size:13px;color:#c2c2cd}.learn-nav a{text-decoration:none}.mentorship-strip{display:flex;align-items:center;justify-content:space-between;gap:30px;border:1px solid #fb647740;background:linear-gradient(110deg,#251419,#111216);border-radius:20px;margin-top:32px;padding:32px}.mentorship-strip h3{font-size:25px;margin:18px 0 10px}.mentorship-strip p{font-size:14px;color:#bcb3b8;max-width:600px;line-height:1.7}.mentorship-strip .btn{flex-shrink:0}@media(max-width:700px){.mentorship-strip{align-items:flex-start;flex-direction:column;padding:24px}}
</style>
