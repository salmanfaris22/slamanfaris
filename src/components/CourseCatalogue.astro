---
import { courses } from '../data/courses';
import CourseCard from './CourseCard.astro';
const filters = ['All courses', 'AI', 'Video editing', 'Web development', 'Marketing', 'Design', 'Free', 'Bundles'];
---
<div data-course-catalogue>
  <div class="course-filters js-only" role="group" aria-label="Filter courses">
    {filters.map((label, i) => <button type="button" data-course-filter={label} aria-pressed={i === 0}>{label}</button>)}
  </div>
  <p class="sr-only" role="status" data-course-count></p>
  <div class="course-grid">{courses.filter(c => c.slug !== 'golang-development').map(course => <CourseCard course={course} />)}</div>
  <p class="empty-courses" data-course-empty hidden>No courses announced in this category yet. <a class="text-link" href="/contact/#course">Ask about upcoming courses</a>.</p>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-course-catalogue]').forEach(root => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-course-filter]');
    const cards = root.querySelectorAll<HTMLElement>('[data-course-category]');
    buttons.forEach(button => button.addEventListener('click', () => {
      const filter = button.dataset.courseFilter;
      let count = 0;
      buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      cards.forEach(card => { card.hidden = filter !== 'All courses' && card.dataset.courseCategory !== filter; if (!card.hidden) count++; });
      root.querySelector<HTMLElement>('[data-course-empty]')!.hidden = count > 0;
      root.querySelector<HTMLElement>('[data-course-count]')!.textContent = `${count} courses in ${filter}`;
    }));
  });
</script>
<style>
.course-filters{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 28px}.course-filters button{border:1px solid #ffffff20;background:#131418;color:#bdbdc7;padding:10px 18px;border-radius:99px;font:inherit;font-size:12px;cursor:pointer}.course-filters button[aria-pressed=true]{background:#f04452;border-color:#f04452;color:white}.course-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.empty-courses{padding:30px;border:1px solid #ffffff20;border-radius:16px;color:#bdbdc7}@media(max-width:1000px){.course-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.course-grid{grid-template-columns:1fr}.course-filters button{padding:9px 13px}}
</style>
